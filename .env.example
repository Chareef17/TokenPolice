DISCORD_TOKEN=
# ใส่ระหว่างพัฒนาเพื่อให้คำสั่งอัปเดตในเซิร์ฟเวอร์ทันที
DISCORD_GUILD_ID=
HISTORICAL_DATABASE_PATH=./data/historical-votes.sqlite
GE6_DATABASE_PATH=./data/ge6-analysis.sqlite
BOT_SETTINGS_DATABASE_PATH=./data/bot-settings.sqlite
TOKENX_EXPLORER_URL=https://scan.tokenx.finance
TOKENX_BLOCKSCOUT_API_URL=https://api.tokenx.finance/api/v2
TOKENX_BLOCKSCOUT_MODE=browser
# ไม่ต้องใส่ ถ้า Blockscout เปิด public API
TOKENX_BLOCKSCOUT_API_KEY=

# GE6 ElectionPoll ที่สร้างใน tx 0x151b2ca5...9919
GE6_INDEXER_ENABLED=true
GE6_CONTRACT_ADDRESS=0x86a1F49e1b1Cbd69971e99B66123264c75Ac2c8F
GE6_START_BLOCK=49475830
GE6_TOKEN_DECIMALS=18
GE6_POLL_INTERVAL_MS=10000
GE6_TARGET_MAP_PATH=./data/ge6-vote-targets.json
# ใช้ chrome หรือ msedge; browser mode ใช้ browser ที่ติดตั้งอยู่แล้วและไม่ต้องใช้ API key
GE6_BROWSER_CHANNEL=chrome
GE6_BROWSER_HEADLESS=true
# ใส่เฉพาะเมื่อต้องระบุ path เอง เช่น C:\Program Files\Google\Chrome\Application\chrome.exe
GE6_BROWSER_EXECUTABLE_PATH=
