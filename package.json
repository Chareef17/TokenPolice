{
  "name": "idol-vote-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:init": "node --import tsx src/init-databases.ts",
    "ge6:sync-roster": "node --import tsx src/sync-ge6-roster.ts",
    "ge6:check-api": "node --import tsx src/check-tokenx-api.ts",
    "import": "tsx src/import-votes.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "decimal.js": "^10.6.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "ethers": "^6.17.0",
    "exceljs": "^4.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
